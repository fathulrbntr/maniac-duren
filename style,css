* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, sans-serif;
  background: #f3f0df;
}

.hero {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: 30px;
}

.hero h1 {
  font-size: clamp(50px, 10vw, 120px);
  line-height: 0.9;
}

.hero p {
  margin-top: 20px;
  font-size: 24px;
}

.btn {
  margin-top: 30px;
  padding: 16px 28px;
  background: #146321;
  color: white;
  text-decoration: none;
  border-radius: 50px;
}